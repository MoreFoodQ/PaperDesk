{
  "name": "paperdesk-desktop",
  "version": "0.3.1",
  "description": "PaperDesk: Traditional Chinese research workbench with Codex CLI",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:backend": "python scripts/build_backend.py",
    "dist": "npm run build:runtime && npm run build:backend && electron-builder --win nsis --x64 --publish never",
    "build:runtime": "python scripts/prepare_desktop_runtime.py"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.paperdesk.desktop",
    "productName": "PaperDesk",
    "protocols": [
      {
        "name": "PaperDesk",
        "schemes": [
          "paperdesk"
        ]
      }
    ],
    "asar": true,
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "icon": "electron/assets",
    "extraResources": [
      {
        "from": "build/backend/easyread-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/codex",
        "to": "codex",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "LICENSE",
        "to": "licenses/EasyRead-MIT.txt"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "signExecutable": "false"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "PaperDesk-Setup-${version}.exe",
      "installerLanguages": [
        "en_US",
        "zh_TW"
      ],
      "displayLanguageSelector": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "perMachine": false
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "publications",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "@electron/get": "5.1.0"
  },
  "author": {
    "name": "MoreFoodQ"
  }
}
